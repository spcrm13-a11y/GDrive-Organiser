# ainie-knowfind runtime configuration.
#
# On theguardian this file is GENERATED by deploy/deploy-knowfind-guardian.sh
# from Infisical and from the fleet telemetry credentials -- never hand-edit it
# there. Every secret change goes into Infisical first, then a redeploy.
# See SP-nginx/infisical-secrets-reference.md ("anchor the truth").

# --- Gemini ---------------------------------------------------------------
# Required for Gemini classification. Without it the app still serves and
# classifies, but only via the deterministic rules engine, and /health reports
# gemini: unconfigured.
# Live value: Infisical project `ainie-spdesk`, env `prod`, key GEMINI_API_KEY.
GEMINI_API_KEY=""

# --- HTTP -----------------------------------------------------------------
PORT="3000"
NODE_ENV="production"

# APP_URL: the URL this app is reached on. Used for self-referential links.
APP_URL="https://knowfind.tail2227aa.ts.net"

# --- Telemetry (SMARTPLANET_APP_STANDARD.md) -------------------------------
# /health is published to smartplanet/telemetry/knowfind every 60s, which the
# telemetry-listener on theguardian consumes into sp_operations.Telemetry.
# Broker: theorchestrator (100.102.174.92:1883).
MQTT_HOST="100.102.174.92"
MQTT_PORT="1883"
MQTT_USER="smartplanet"
MQTT_PASSWORD=""

# --- Tailscale sidecar ----------------------------------------------------
# Ephemeral, reusable auth key for the knowfind-tailscale node. The sidecar
# serves https://knowfind.tail2227aa.ts.net with its own Tailscale-issued
# certificate; TS_STATE_DIR is set in compose and is NOT optional (a sidecar
# without it loses its serve config on restart and the URL goes dead).
TS_AUTHKEY=""

# --- Authentik outpost ----------------------------------------------------
# Token for the KnowFind dedicated outpost, from the Authentik admin UI
# (Applications -> Outposts -> KnowFind Dedicated Outpost -> View token).
AUTHENTIK_TOKEN=""
AUTHENTIK_HOST="http://authentik-server-1:9000"
# The Authentik LOGIN host, not this app's host.
AUTHENTIK_HOST_BROWSER="https://theguardian.tail2227aa.ts.net"
